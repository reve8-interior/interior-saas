ENV=production
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, port 5432)
# Keep the `postgresql+psycopg://` scheme and append ?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
API_BASE_URL=https://<service>.onrender.com
FRONTEND_URL=https://<project>.vercel.app
ALLOWED_ORIGINS=https://<project>.vercel.app
N8N_WEBHOOK_SECRET=
SECRETS_ENCRYPTION_KEY=
# Design images: private Supabase Storage bucket (create it in Storage -> New bucket, keep Public OFF)
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=design-images
