# Copy to tools/snapshot.env (gitignored). ALL variables are required; the script has no defaults.
# Path only: never put the key itself here.

# Create a dedicated key for the snapshot account (no passphrase, so the script can run unattended):
#   ssh-keygen -t ed25519 -C "interior@reve8.com" -f ~/.ssh/id_reve8_interior -N ""
# Then add ~/.ssh/id_reve8_interior.pub to the snapshot repo: GitHub > repo > Settings >
# Deploy keys > Add deploy key, with "Allow write access" ticked.
# Verify: ssh -i ~/.ssh/id_reve8_interior -o IdentitiesOnly=yes -T git@github.com
SNAPSHOT_SSH_KEY=/c/Users/ralajan/.ssh/id_reve8_interior

SNAPSHOT_REMOTE_URL=git@github.com:reve8-interior/interior-saas.git
SNAPSHOT_AUTHOR_NAME=reve8-interior
SNAPSHOT_AUTHOR_EMAIL=interior@reve8.com
